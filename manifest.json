{
  "manifest_version": 3,
  "name": "HeadSpace 8D",
  "version": "1.2.0",
  "description": "Processa o áudio da aba ativa em tempo real com efeitos espaciais 8D, reverbs, ambientes relaxantes e ondas binaurais.",
  "permissions": [
    "activeTab",
    "tabs",
    "tabCapture",
    "offscreen",
    "storage",
    "scripting",
    "notifications"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HeadSpace 8D",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}